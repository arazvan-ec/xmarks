index 0ba8e61..024f5c5 100644
--- a/slugify.py
+++ b/slugify.py
@@ -3,12 +3,15 @@ import unicodedata
 
 
 def slugify(title):
+    # NFKD first, then an ASCII encode: folding accents this way keeps the
+    # result stable across the two Python versions the CMS still runs.
     norm = unicodedata.normalize("NFKD", title)
     ascii_only = norm.encode("ascii", "ignore").decode("ascii")
     return re.sub(r"[^a-z0-9]+", "-", ascii_only.lower()).strip("-")
 
 
 def unique_slug(title, taken):
+    # The bare slug belongs to the first article, so the counter starts at 2.
     base = slugify(title)
     if base not in taken:
         return base
