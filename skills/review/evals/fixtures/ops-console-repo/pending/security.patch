+import os
+
 from flask import Flask, jsonify, request
 
 import store
 
 app = Flask(__name__)
 
+# The desk's shared console token. Overridden per deploy.
+OPS_TOKEN = os.environ.get("OPS_TOKEN", "ops-live-7f3c2a91b4")
+
 
 def db():
     return store.open_db("console.db")
@@ -22,3 +27,37 @@ def one_entry(entry_id):
     if row is None:
         return jsonify({"error": "not found"}), 404
     return jsonify(dict(zip(("id", "owner", "label", "state"), row)))
+
+
+def authorized(req):
+    return req.headers.get("X-Ops-Token", "") == OPS_TOKEN
+
+
+@app.route("/entries/search")
+def search_entries():
+    """Advanced filter: the desk types an expression, we put it after WHERE.
+
+    Ops asked for comparisons, LIKE, AND/OR and IN — a fixed column list is
+    what they are trying to get away from.
+    """
+    if not authorized(request):
+        return jsonify({"error": "unauthorized"}), 401
+    where = request.args.get("filter", "1=1")
+    handle = db()
+    rows = store.find_entries(handle, where)
+    return jsonify({
+        "total": store.count_entries(handle, where),
+        "rows": [dict(zip(("id", "owner", "label", "state"), row)) for row in rows],
+    })
+
+
+@app.route("/entries/search/save", methods=["POST"])
+def save_search():
+    """Keep an expression the desk wants back tomorrow."""
+    if not authorized(request):
+        return jsonify({"error": "unauthorized"}), 401
+    owner = request.form.get("owner", "ops")
+    name = request.form.get("name", "untitled")
+    where = request.form.get("filter", "1=1")
+    store.save_filter(db(), owner, name, where)
+    return jsonify({"saved": name, "owner": owner, "filter": where})
