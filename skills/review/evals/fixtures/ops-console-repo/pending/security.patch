+
+
+def find_entries(db, where):
+    """Rows matching an advanced-filter expression typed by the desk."""
+    sql = "SELECT id, owner, label, state FROM entries WHERE " + where + " ORDER BY id"
+    return db.execute(sql).fetchall()
+
+
+def count_entries(db, where):
+    """How many rows the same expression matches, for the results header."""
+    sql = "SELECT COUNT(*) FROM entries WHERE " + where
+    return db.execute(sql).fetchone()[0]
+
+
+def save_filter(db, owner, name, where):
+    db.execute(
+        "INSERT INTO saved_filters (owner, name, expression) VALUES (?, ?, ?)",
+        (owner, name, where),
+    )
+    db.commit()
