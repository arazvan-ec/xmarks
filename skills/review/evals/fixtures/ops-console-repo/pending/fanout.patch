         "SELECT id, owner, label, state FROM entries WHERE id = ?", (entry_id,)
     )
     return cur.fetchone()
+
+
+def ids_for_state(db, state):
+    cur = db.execute("SELECT id FROM entries WHERE state = ? ORDER BY id", (state,))
+    return [row[0] for row in cur.fetchall()]
+
+
+def mark_exported(db, entry_id):
+    db.execute("UPDATE entries SET state = 'exported' WHERE id = ?", (entry_id,))
+    db.commit()
