{
  "extraKnownMarketplaces": {
    "xmarks": {
      "source": {
        "source": "github",
        "repo": "arazvan-ec/xmarks"
      }
    }
  },
  "enabledPlugins": {
    "flywheel@xmarks": true
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/check-invocation-budget.sh:*)",
      "Bash(bash scripts/test-check-invocation-budget.sh:*)",
      "Bash(bash scripts/check-description-budget.sh:*)",
      "Bash(bash scripts/test-check-test-pairing.sh:*)",
      "Bash(bash scripts/test-install-vendored.sh:*)",
      "Bash(bash scripts/test-docs-consistency.sh:*)",
      "Bash(bash scripts/test-session-start.sh:*)",
      "Bash(bash scripts/check-test-pairing.sh:*)",
      "Bash(bash scripts/test-run-cost.sh:*)",
      "Bash(bash scripts/run-cost.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/git-tracking-refs.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/read-prime.sh",
            "timeout": 5
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/write-allow.sh",
            "timeout": 5
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/bash-allow.sh",
            "timeout": 10
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/delegation-guard.sh",
            "timeout": 5
          }
        ],
        "matcher": "mcp__.*__create_session|Agent|Task"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/gate.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/delegation-record.sh",
            "timeout": 5
          }
        ],
        "matcher": "mcp__.*__create_session|Agent|Task"
      }
    ]
  }
}
